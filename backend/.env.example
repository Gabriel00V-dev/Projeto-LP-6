# Copie para .env e preencha com os valores reais.
# Em produção, configure estas variáveis no painel da Vercel
# (Settings > Environment Variables), nunca neste arquivo.

DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"
JWT_SECRET=""
PORT=3333
SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave anon (publica) — usada nas operacoes de autenticacao
SUPABASE_KEY=""

# Chave service_role — usada para acessar as tabelas passando pelo RLS.
# Nunca exponha esta chave no app nem em qualquer codigo que va para o cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# Fuso usado para comparar "agora" com o horario das consultas.
APP_TIMEZONE="America/Sao_Paulo"

# Telemedicina. Prototipo: Jitsi publico. Producao: Jitsi self-hosted.
JITSI_BASE_URL="https://meet.jit.si"
JITSI_ROOM_PREFIX="saude-municipal"
TELEMEDICINA_MINUTOS_ANTES=10
TELEMEDICINA_TOLERANCIA_MINUTOS=15
